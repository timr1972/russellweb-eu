---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() -
      a.data.pubDate.getTime()
  );

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog'))
    .filter(post => !post.data.draft)
    .sort(
      (a, b) =>
        b.data.pubDate.getTime() -
        a.data.pubDate.getTime()
    );

  return paginate(posts, {
    pageSize: 5,
  });
}

const { page } = Astro.props;

const cleanBaseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Blog">

  <section class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold mb-2">Blog</h1>
    <p class="text-slate-400 mb-10">
      Projects, kit cars, Arduino experiments and general updates.
    </p>

    <div class="space-y-6">
      {page.data.map((post) => (
        <article
          class="rounded-xl border border-slate-700/50 bg-slate-900/30 p-6 transition-all hover:border-cyan-400/50 hover:bg-slate-900/50"
        >
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">

            <div>
              <a
                href={`${cleanBaseUrl}/blog/${post.id}/`}
                class="text-2xl font-semibold text-accent hover:text-cyan-200"
              >
                {post.data.title}
              </a>

              {post.data.description && (
                <p class="mt-3 text-slate-600">
                  {post.data.description}
                </p>
              )}
            </div>

            <div class="text-sm text-accent whitespace-nowrap">
              {post.data.pubDate.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              })}
            </div>

          </div>
        </article>
      ))}
    </div>

    <nav class="flex justify-between items-center mt-12">
      <div>
        {page.url.prev && (
          <a
            href={page.url.prev}
            class="inline-block rounded-lg bg-slate-800 px-5 py-3 hover:bg-slate-700"
          >
            ← Newer Posts
          </a>
        )}
      </div>

      <div class="text-slate-500">
        Page {page.currentPage}
      </div>

      <div>
        {page.url.next && (
          <a
            href={page.url.next}
            class="inline-block rounded-lg bg-slate-800 px-5 py-3 hover:bg-slate-700"
          >
            Older Posts →
          </a>
        )}
      </div>
    </nav>

  </section>

</BaseLayout>
